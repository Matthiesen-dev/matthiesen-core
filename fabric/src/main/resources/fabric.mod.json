{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${modrinth_url}",
    "issues": "${github_url}/issues",
    "sources": "${github_url}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "${github_url}",
        "modmenu.discord": "${discord_url}"
      }
    }
  },
  "environment": "*",
  "mixins": [
    "matthiesen_core.mixins.json",
    "matthiesen_core_fabric.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "dev.matthiesen.matthiesen_core.fabric.MatthiesenCoreFabric"
    ],
    "client": [
      "dev.matthiesen.matthiesen_core.fabric.MatthiesenCoreFabricClient"
    ]
  },
  "depends": {
    "minecraft": "1.21.1",
    "fabric-api": "*"
  },
  "recommends": {
    "fabric-permissions-api-v0": "*"
  },
  "suggests": {
    "adventure-platform-fabric": "*",
    "emberstextapi": ">=3.0.0 <4.0.0",
    "impactor": ">=5.3.5+1.21.1",
    "luckperms": ">=5.4 <6.0.0",
    "mysql-jdbc": ">=9.7.0+2026-05-03",
    "sqlite-jdbc": ">=3.53.2.0+2026-06-06"
  }
}